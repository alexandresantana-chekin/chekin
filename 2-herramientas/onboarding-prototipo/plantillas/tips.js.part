  var TIPS={
    entrar:{t:"Una sola puerta para entrar o darse de alta",p:"Con Google o con email y un código de 6 dígitos, sin contraseñas. Si el email ya es cliente, entra a su panel. Si es nuevo, antes de crear la cuenta pide nombre, apellidos, NIF/NIE/CIF y móvil (con Google, nombre y apellidos ya vienen). Al continuar acepta Condiciones y Privacidad; el boletín es opcional y va sin marcar.",l:["Dato: en Clarity, 1 de cada 4 sesiones de ordenador en el alta buscaban el login.", "Dato: hoy solo el 16 % de quien llega al alta crea la cuenta (126 de 772, 30 días): pedir NIF y móvil antes puede bajarlo; medirlo en el A/B.", "El NIF pasa solo al paso del titular y el móvil ya no se pide en «Tu negocio»: nada se pide dos veces.", "Por comprobar: textos legales, base legal del móvil y si la puerta única puede revelar que un email ya es cliente (DPO).", "Pruébalo: «Cliente nuevo», «Ya tiene cuenta» y «Demo: código incorrecto»."]},
    negocio:{t:"Dos preguntas rápidas",p:"Si elige hotel o camping, el resto del alta habla de «propiedades» en vez de «viviendas». Qué gestiona y cuántas unidades (número exacto con − y +); el móvil ya se pidió al crear la cuenta. Si la cartera es grande, ofrece un experto: con más de 10 viviendas, o más de 60 habitaciones o parcelas en hoteles y campings, en las dos salidas.",l:["Por comprobar: la regla exacta de 60 habitaciones (corte de Mid-Market/Enterprise en HubSpot, H-52).", "Pruébalo: pon 12 viviendas, o Hotel y 70."]},
    creando:{t:"Una sola confirmación de cuenta creada",p:"El logo late mientras se crea la cuenta y el check crece con «¡Cuenta creada!». A los 1,6 s aparece «Continuar»; si no lo pulsa, avanza solo a los 4,6 s.",l:["Dato: antes había tres confirmaciones seguidas de lo mismo y 6 s de espera (auditoría).", "Con «reducir movimiento» activado, sin animaciones."]},
    bienvenida:{t:"Qué viene y cuánto tarda",p:"Los 7 pasos con su tiempo, unos 11 minutos en total. Se guarda solo y se puede seguir luego. «Ahora no» lleva al Inicio de cuenta nueva, con lo que falta como tareas.",l:["Pruébalo: pulsa «Ahora no» y mira el Inicio de cuenta nueva."]},
    reservas:{t:"Paso 1: cómo le llegan las reservas",p:"Tres formas, ordenadas según el dispositivo. En portátil, primero el PMS; en móvil, primero el calendario de Airbnb o Booking. «A mano» es para probar sin conectar nada.",l:["Dato: en móvil casi nadie conecta el PMS (2 de 236 sesiones, Clarity).", "Pruébalo: cada opción lleva a un camino distinto y el resumen final cambia según cuál elijas."]},
    elegirpms:{t:"Elegir el PMS por su logo",p:"Los más usados a la vista y un buscador. El nombre elegido aparece en el resto de pantallas.",l:["Por comprobar: si son +200 PMS (web) u 81 integraciones (prototipo de Daniel)."]},
    conectar:{t:"Conectar el PMS sin copiar nada",p:"Como «Iniciar sesión con Google»: autoriza en la web de su PMS y vuelve solo. Chekin no ve su contraseña.",l:["Por comprobar: qué PMS permiten autorizar así; el resto va por API key.", "Pruébalo: «Demo: permiso rechazado»."]},
    apikey:{t:"La API key, para quien no es técnico",p:"Tres pasos, una frase que explica qué es y cómo se guarda la clave y cómo revocarla.",l:["Por comprobar: el cifrado real de las claves (Producto). Vídeos por grabar.", "Pruébalo: «Demo: clave no válida»."]},
    calendario:{t:"Pegar el enlace del calendario",p:"Un enlace por anuncio, con dónde encontrarlo en Airbnb y en Booking. Al pegarlo, confirma las reservas encontradas; «+ Añadir otro anuncio» suma más.",l:["Dato: antes esta opción prometía «pegas el enlace» y no había dónde pegarlo (auditoría).", "Por comprobar: las rutas de menú de Airbnb y Booking en sus pantallas actuales.", "Pruébalo: pega cualquier texto largo en el campo."]},
    cartera:{t:"Paso 2 con PMS: lo que ya sabemos",p:"Una lectura, no una importación: las viviendas aparecen agrupadas por zona y por la policía a la que envían el parte.",l:["Idea del prototipo de Daniel."]},
    paises:{t:"Paso 2 sin PMS: dónde están las viviendas",p:"Selección múltiple de países. España abre la comunidad: Cataluña (Mossos), País Vasco (Ertzaintza) o resto (SES). Así se activa solo lo que pide la ley en cada sitio.",l:["Dato: países de chekin.com/legalidad (30/10)."]},
    titular:{t:"Paso 3: el titular, una vez",p:"Nombre o razón social y NIF, NIE o CIF, comprobado al escribirlo. Si se dieron en el alta, vienen rellenos («Lo traemos de tu alta»). «El mismo titular para todas» viene marcado; un gestor con pisos de varios propietarios lo desmarca.",l:["Dato: en SES el titular es el dueño de la actividad, no quien la gestiona (Kinapi, 05/09/2026).", "Pruébalo: crea la cuenta con Google o escribe un NIF en el alta, y llega aquí."]},
    vivienda:{t:"Paso 3: las viviendas, una a una y con lo mínimo",p:"Solo nombre y dirección con autocompletado. El registro turístico y el código de SES se piden en el parte, donde hacen falta. Al guardar cada una, elige seguir o terminar.",l:["Dato: es el paso con más caída: crean la primera vivienda el 58,2 % (alquiler vacacional) y el 32,9 % (hoteles) (altas solas, 07/06–03/09/2026).", "Pruébalo: «Demo: dirección no encontrada»."]},
    legal:{t:"Paso 4: el parte de viajeros, sin bloquear",p:"Una autoridad cada vez, plegada, con dos salidas: «Tengo los datos» (formulario y Conectar) o «No los tengo: ayúdame» (vídeo, un experto, recuérdamelo y, en móvil, mándamelo al ordenador). Lo pendiente pasa a tarea en el Inicio. Cada formulario dice cómo se guardan las claves. Identidad y tasa turística se configuran una vez; la tasa, apagada; la selfie pide consentimiento al huésped.",l:["Dato: era la fricción crítica de la auditoría: tres formularios con contraseña a la vez.", "Por comprobar: qué campos pide Chekin para cada autoridad, el cifrado real, el texto del consentimiento de la selfie (DPO) y qué municipios cobran tasa.", "Pruébalo: «Demo: datos incorrectos» y luego «Conectar»."]},
    proteccion:{t:"Paso 5: protección de daños y fianza",p:"Ventajas, vídeo y, para todas las viviendas, la protección de daños y la fianza con su importe y quién paga. Vienen apagadas: «Activar las dos en un clic» o una a una. Se dice quién cobra y se enlazan comisiones y cómo se reclama un daño.",l:["Dato: cifras del prototipo de Daniel: hasta 2.500 €, 27,20 € por estancia y fianza de 200 € devuelta en 7 días.", "Por comprobar: esas cifras, la comisión y el proceso de reclamación (Producto)."]},
    ventas:{t:"Paso 6: ventas extra, de lo básico a todo",p:"Cuatro preguntas de sí o no (entrar antes, salir tarde, mascotas, aparcamiento), cada una con su precio y cómo se cobra. «Mira todos los extras» despliega el catálogo y «Crea tu propia oferta». El móvil del huésped se rellena en vivo. Nada viene activado.",l:["Por comprobar: qué extras tiene hoy Chekin, cómo cobra cada uno y la comisión (Producto). Precios de ejemplo.", "Pruébalo: di «Sí» a mascotas, cambia a «por estancia» y abre el catálogo."]},
    envio:{t:"Paso 7: cuándo llega el check-in",p:"Envío automático sí o no, y con cuánta antelación: al confirmar, 72, 48 o 24 h. Vista del huésped y enlace de prueba.",l:["Por comprobar: si 48 h es el envío por defecto."]},
    listo:{t:"Un resumen que dice la verdad",p:"Cambia según lo hecho: reservas desde el PMS, el calendario o a mano; viviendas añadidas o pendientes; parte conectado o pendiente; identidad, tasa, protección y extras activados o no. Dice cuándo acaba la prueba.",l:["Dato: antes afirmaba cosas que no se habían hecho (auditoría).", "Pruébalo: recorre el alta saltando pasos y mira cómo cambia."]},
    panelnuevo:{t:"El Inicio de una cuenta nueva",p:"Sin datos inventados: «Lo que te queda» según lo hecho en el alta, «Aún no tienes reservas», el estado real de protección y extras, y «Tu prueba gratis» con los días que quedan y el plan después. Debajo, cómo se verá con reservas.",l:["Dato: antes, quien saltaba el alta veía un Inicio lleno de datos de ejemplo (auditoría).", "Por comprobar: el precio real: 39 €/mes es un ejemplo."]},
    panel:{t:"El Inicio con reservas: primero la operación",p:"Arriba, lo que se contrata Chekin para: llegadas, huéspedes, check-ins hechos, partes enviados y lo que falta, con el parte por autoridad. Debajo, las próximas reservas. Al final, las ventas extra: «tus extras pagan Chekin». La lista de ofertas queda detrás de un enlace.",l:["Dato: datos de ejemplo: 165 € en extras pagan 4 meses de un plan de 39 €/mes.", "Por comprobar: el precio real del plan."]}
  };
  var tipsOn=true, tip=document.querySelector('[data-tip]'), sw=document.querySelector('[data-tips]');
  function showTip(id){
    var d=TIPS[id]; if(!tip){return;}
    if(!tipsOn||!d){ tip.hidden=true; return; }
    tip.querySelector('[data-tip-t]').textContent=d.t;
    tip.querySelector('[data-tip-p]').textContent=d.p;
    var ul=tip.querySelector('[data-tip-l]'); ul.innerHTML='';
    (d.l||[]).forEach(function(x){ var li=document.createElement('li'); li.textContent=x; ul.appendChild(li); });
    tip.hidden=true; void tip.offsetWidth; tip.hidden=false;
  }
  if(sw){ sw.addEventListener('click',function(){ tipsOn=!tipsOn; sw.setAttribute('aria-pressed',tipsOn?'true':'false'); sw.textContent='Explicaciones: '+(tipsOn?'sí':'no'); showTip(current()); }); }
  if(tip){ tip.querySelector('[data-tip-close]').addEventListener('click',function(){ tip.hidden=true; }); }
  document.addEventListener('input',function(e){
    var g=e.target.closest('[data-otp-go]');
    if(g){ var ins=[].slice.call(g.querySelectorAll('input')); var i=ins.indexOf(e.target);
      e.target.value=(e.target.value||'').replace(/\D/g,'').slice(0,1);
      if(e.target.value && i<ins.length-1){ ins[i+1].focus(); }
      if(ins.every(function(x){return x.value;})){ var go=g.getAttribute('data-otp-go'); setTimeout(function(){ ins.forEach(function(x){x.value='';}); location.hash=go; },350); } }
    var a=e.target.closest('[data-addr-input]');
    if(a){ var box=a.closest('[data-addr]'); box.querySelector('[data-addr-list]').hidden = a.value.trim().length<2; box.querySelector('[data-addr-ok]').hidden=true; }
  });
  document.addEventListener('keydown',function(e){
    var g=e.target.closest&&e.target.closest('[data-otp-go]');
    if(g&&e.key==='Backspace'&&!e.target.value){ var ins=[].slice.call(g.querySelectorAll('input')); var i=ins.indexOf(e.target); if(i>0){ ins[i-1].focus(); } }
  });
  document.addEventListener('click',function(e){
    var p=e.target.closest('[data-addr-pick]');
    if(p){ var box=p.closest('[data-addr]'); var inp=box.querySelector('[data-addr-input]'); inp.value=p.getAttribute('data-addr-pick'); box.querySelector('[data-addr-list]').hidden=true; box.querySelector('[data-addr-ok]').hidden=false; }
  });
