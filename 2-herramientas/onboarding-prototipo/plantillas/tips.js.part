  var TIPS={
    entrar:{t:'Una sola puerta: Chekin reconoce el email',p:'Login y alta en la misma pantalla, con Google o con email y un código de 6 dígitos. Si el email existe, entra a su panel; si es nuevo, nombre y apellidos y sigue. Sin contraseñas.',l:['En Clarity, 1 de cada 4 sesiones de ordenador en el alta buscaban el login.','Prueba «Cliente nuevo» y «Ya tiene cuenta».']},
    negocio:{t:'Tres datos, y el teléfono opcional',p:'Número exacto con − y +; teléfono opcional, con prefijo según el país y para qué se usa. El aviso del experto salta con más de 10 viviendas, o más de 60 habitaciones o parcelas en hoteles y campings, y en las dos salidas.',l:['Umbral de hoteles: 60 habitaciones, el corte de Mid-Market/Enterprise en HubSpot [POR COMPROBAR la regla exacta, H-52].']},
    creando:{t:'Como abrir un producto de Apple',p:'Ritmo buscado: el logo marino late mientras se crea la cuenta, los textos cambian con suavidad y, al terminar, el check crece y se ilumina con «¡Cuenta creada!», que se queda unos 3 s para que se lea.',l:['Un solo color, el marino, de principio a fin.','Con «reducir movimiento» activado, sin animaciones.']},
    bienvenida:{t:'Lo que viene y cuánto tarda',p:'Los 7 pasos con su tiempo (≈ 10 min), en una tarjeta compacta. Todo se hace de una vez, se guarda solo y se puede seguir luego.',l:[]},
    reservas:{t:'Paso 1: tres formas, ordenadas según el dispositivo',p:'En portátil, primero el PMS (el más rápido); en móvil, primero el calendario, porque casi nadie conecta el PMS desde el móvil (2 de 236 sesiones en Clarity). «A mano» ya no compite en rapidez: es para probar sin conectar nada.',l:['Arreglo de la auditoría (oleada 2).']},
    elegirpms:{t:'Elegir el PMS por su logo',p:'Los más usados a la vista y un buscador. El nombre elegido aparece en el resto de pantallas.',l:['+200 PMS en la web frente a 81 integraciones en el prototipo de Daniel [POR COMPROBAR].']},
    conectar:{t:'Conectar sin copiar nada',p:'Como «Iniciar sesión con Google»: el cliente autoriza en la web de su PMS y vuelve solo. Chekin nunca ve la contraseña.',l:['Solo en los PMS que lo permiten [POR COMPROBAR]. Para el resto, la API key con guía y vídeo.']},
    apikey:{t:'La API key, para quien no es técnico',p:'Tres pasos y una frase que explica qué es.',l:['Vídeos [POR GRABAR].']},
    cartera:{t:'Paso 2 con PMS: lo que ya sabemos',p:'Una lectura, no una importación: las líneas aparecen una a una y los números suben contando. Las viviendas se agrupan por zona y su policía.',l:['Idea del prototipo de Daniel.']},
    paises:{t:'Paso 2 sin PMS: países, con selección múltiple',p:'Buscador, los 3 principales a la vista y el resto en «Ver más países». España abre la comunidad: Cataluña (Mossos), País Vasco (Ertzaintza) o resto (SES).',l:['Países de chekin.com/legalidad (30/10).']},
    titular:{t:'Paso 3: el titular, una vez',p:'Nombre o razón social y NIF, NIE o CIF, comprobado al escribirlo. «El mismo titular para todas» viene marcado; un gestor con pisos de varios propietarios lo desmarca.',l:['En SES el titular es el dueño de la actividad, no quien la gestiona (Kinapi, 05/09/2026).','Prueba a escribir 12345678Z.']},
    vivienda:{t:'Paso 3: las viviendas, una a una y solo con lo mínimo',p:'Nombre y dirección con autocompletado, y nada más. El piso, el registro turístico y el código de SES se piden donde hacen falta (en el parte de viajeros), no aquí. Al guardar cada una: «¡Bien hecho, Katia!» y elige seguir o terminar.',l:['Es el paso con más caída: 58,2 % (alquiler vacacional) y 32,9 % (hoteles) crean la primera vivienda (altas solas, 07/06–03/09/2026).','Arreglo de la auditoría: antes decía «solo nombre y dirección» y pedía 5 campos.']},
    legal:{t:'Paso 4: una autoridad cada vez y sin bloquear',p:'Cada autoridad, plegada, con dos opciones: «No los tengo: ayúdame» (vídeo, un experto, recuérdamelo y, en móvil, mándamelo al ordenador) o «Tengo los datos». Lo pendiente pasa a ser una tarea en el Inicio.',l:['Era la fricción crítica de la auditoría: tres formularios con contraseña a la vez.','Prueba «Demo: datos incorrectos» para ver el error.']},
    proteccion:{t:'Paso 5: protección como la de Daniel, con nuestro diseño',p:'Ventajas (respaldo económico, cobro inmediato), vídeo, y para «Todas tus viviendas» la protección de daños y la fianza con su importe, quién paga, ajustes y «Separar por grupos». Sin «obligatorio/opcional»: vienen activadas y se pueden apagar.',l:['Cifras del prototipo de Daniel (hasta 2.500 €, 27,20 € por estancia, fianza de 200 € devuelta en 7 días) [POR COMPROBAR con Producto].']},
    ventas:{t:'Paso 6: el check-in también vende',p:'Cuatro ofertas activadas con precio editable.',l:[]},
    envio:{t:'Paso 7: cuándo llega el check-in',p:'Envío automático sí o no, y con cuánta antelación: al confirmar, 72, 48 o 24 h. Vista del huésped y enlace de prueba.',l:['48 h por defecto [POR COMPROBAR].']},
    listo:{t:'Un resumen que dice la verdad',p:'Cambia según el camino: reservas desde el PMS, el calendario o a mano; viviendas añadidas o pendientes; parte de viajeros conectado o «pendiente: te lo recordamos». Y el botón grande para entrar al panel.',l:['Arreglo de la auditoría: antes afirmaba cosas que no se habían hecho.']},
    calendario:{t:'Pegar el enlace del calendario',p:'Un enlace por anuncio, con dónde encontrarlo en Airbnb y en Booking. Al pegarlo, «✓ Calendario conectado: 3 reservas encontradas».',l:['Antes, esta opción prometía «pegas el enlace» y saltaba a otra pantalla (auditoría).','Las rutas de menú de Airbnb y Booking [POR COMPROBAR con sus pantallas actuales].']},
    panelnuevo:{t:'El Inicio de verdad para una cuenta nueva',p:'Sin datos inventados: «Lo que te queda» (parte de viajeros, viviendas, primera reserva) según lo que hizo en el alta, «Aún no tienes reservas» y las ventas extra listas. Debajo, cómo se verá con reservas.',l:['Arreglo de la auditoría: antes, quien saltaba el alta veía un Inicio lleno de datos de ejemplo.']},
    panel:{t:'El Inicio: primero la operación, después los extras',p:'Arriba, lo que se contrata Chekin para: llegadas, huéspedes, check-ins hechos, partes enviados y lo que falta. Al lado, el parte de viajeros por autoridad (sin él no se envía el check-in) y las viviendas listas. Debajo, las próximas reservas con su envío. Y al final, las ventas extra contadas como «Chekin te sale gratis».',l:['Los extras cubren 4,2 meses de suscripción: 165 € frente a 39 €/mes. Precio de ejemplo [POR COMPROBAR con los precios reales].','La lista de ofertas queda detrás de «Ver tus 4 ofertas».','Datos de ejemplo.']},
  };
  var tipsOn=true, tip=document.querySelector('[data-tip]'), sw=document.querySelector('[data-tips]');
  function showTip(id){
    var d=TIPS[id]; if(!tip){return;}
    if(!tipsOn||!d){ tip.hidden=true; return; }
    tip.querySelector('[data-tip-t]').textContent=d.t;
    tip.querySelector('[data-tip-p]').textContent=d.p;
    var ul=tip.querySelector('[data-tip-l]'); ul.innerHTML='';
    (d.l||[]).forEach(function(x){ var li=document.createElement('li'); li.textContent=x; ul.appendChild(li); });
    tip.hidden=true; void tip.offsetWidth; tip.hidden=false;
  }
  if(sw){ sw.addEventListener('click',function(){ tipsOn=!tipsOn; sw.setAttribute('aria-pressed',tipsOn?'true':'false'); sw.textContent='Explicaciones: '+(tipsOn?'sí':'no'); showTip(current()); }); }
  if(tip){ tip.querySelector('[data-tip-close]').addEventListener('click',function(){ tip.hidden=true; }); }
  document.addEventListener('input',function(e){
    var g=e.target.closest('[data-otp-go]');
    if(g){ var ins=[].slice.call(g.querySelectorAll('input')); var i=ins.indexOf(e.target);
      e.target.value=(e.target.value||'').replace(/\D/g,'').slice(0,1);
      if(e.target.value && i<ins.length-1){ ins[i+1].focus(); }
      if(ins.every(function(x){return x.value;})){ var go=g.getAttribute('data-otp-go'); setTimeout(function(){ ins.forEach(function(x){x.value='';}); location.hash=go; },350); } }
    var a=e.target.closest('[data-addr-input]');
    if(a){ var box=a.closest('[data-addr]'); box.querySelector('[data-addr-list]').hidden = a.value.trim().length<2; box.querySelector('[data-addr-ok]').hidden=true; }
  });
  document.addEventListener('keydown',function(e){
    var g=e.target.closest&&e.target.closest('[data-otp-go]');
    if(g&&e.key==='Backspace'&&!e.target.value){ var ins=[].slice.call(g.querySelectorAll('input')); var i=ins.indexOf(e.target); if(i>0){ ins[i-1].focus(); } }
  });
  document.addEventListener('click',function(e){
    var p=e.target.closest('[data-addr-pick]');
    if(p){ var box=p.closest('[data-addr]'); var inp=box.querySelector('[data-addr-input]'); inp.value=p.getAttribute('data-addr-pick'); box.querySelector('[data-addr-list]').hidden=true; box.querySelector('[data-addr-ok]').hidden=false; }
  });
